# Frontend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Backend / Wiro
WIRO_APP_NAME="Mom Test Wiro Backend"
WIRO_PROVIDER_NAME=wiro
WIRO_API_BASE_URL=https://api.wiro.ai/v1
WIRO_REALTIME_WEBSOCKET_URL=wss://socket.wiro.ai/v1

# Auth is disabled for now.
# Available values: none, api-key, signature
WIRO_AUTH_MODE=none

# Optional: only needed if you enable auth later
# WIRO_API_KEY=your-api-key
# WIRO_API_SECRET=your-api-secret

WIRO_REALTIME_OWNER_SLUG=openai
WIRO_REALTIME_MODEL_SLUG=gpt-realtime
WIRO_REPORT_OWNER_SLUG=Qwen
WIRO_REPORT_MODEL_SLUG=Qwen3.6-27B
WIRO_VOICE_PROFILE=marin
WIRO_INPUT_AUDIO_FORMAT=audio/pcm
WIRO_OUTPUT_AUDIO_FORMAT=audio/pcm
WIRO_INPUT_AUDIO_RATE=24000
WIRO_OUTPUT_AUDIO_RATE=24000
# Optional: override the realtime Run payload with the exact schema fields
# WIRO_REALTIME_PAYLOAD_JSON={"agent_id":"your-elevenlabs-agent-id"}
